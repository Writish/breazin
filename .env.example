# Select development, staging, or production. Development is the safe default.
BREAZIN_ENVIRONMENT=development

# Optional community skill catalog. Must be an explicitly trusted HTTPS or file URL.
BREAZIN_SKILLS_BASE=

# Telemetry remains disabled when these values are absent.
SENTRY_DSN=
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com

# External distribution only; never commit real values.
SIGNING_IDENTITY=
NOTARY_PROFILE=
SPARKLE_PUBLIC_KEY=
PROVISION_PROFILE=
KEYCHAIN_ACCESS_GROUP=
